cabal-version:      2.4
name:               retirement-calculator
version:            0.1.0.0
synopsis:           A simple retirement planning calculator for the Indian context
description:        A small JSON API for retirement corpus projections.
license:            MIT
author:             Prasanna Kumar
category:           Finance, Web
build-type:         Simple

executable retirement-calculator
    main-is:          Main.hs
    hs-source-dirs:   src
    other-modules:    Types
                    , Tax
                    , Calculator
                    , Api

    build-depends:    base       >=4.17 && <5
                    , scotty     >=0.20
                    , aeson      >=2.1
                    , text
                    , wai
                    , wai-cors
                    , warp
                    , http-types

    default-language: Haskell2010

    -- -threaded is required by Warp's timeout manager.
    ghc-options:      -Wall -Wcompat -Wincomplete-record-updates
                      -threaded -rtsopts "-with-rtsopts=-N"
